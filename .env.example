# Which LLM to use: "openai" or "ollama"
LLM_PROVIDER=openai

# OpenAI (needed only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.1
OPENAI_GUARDRAIL_MODEL=gpt-5.4-nano

# Ollama (needed only when LLM_PROVIDER=ollama)
OLLAMA_AGENT_MODEL=gemma3:4b
OLLAMA_GUARDRAIL_MODEL=gemma3:4b

# the mid-tier model 
OPENAI_MID_MODEL=gpt-5.4-mini
OLLAMA_MID_MODEL=gemma3:4b

# RAG settings
CHUNK_SIZE=200
CHUNK_OVERLAP=40
TOP_K=4
